{
  "name": "encargado",
  "version": "0.1.1",
  "private": true,
  "description": "Predictable development environments for Elixir/Phoenix projects on Linux",
  "repository": { "type": "git", "url": "https://github.com/ingenious-agency/encargado.git" },
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24.12.0" },
  "bin": { "encargado": "bin/encargado" },
  "files": ["bin", "dist", "README.md", "SECURITY.md", "docs", "examples"],
  "scripts": {
    "start": "node src/cli.ts",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "test:package": "node --test test/package.test.integration.ts",
    "test:live": "node --test test/live/*.test.ts",
    "test:phoenix": "node --test test/phoenix.test.integration.ts"
  },
  "devDependencies": { "@types/node": "^26.6.5", "typescript": "^5.9.3" }
}
